# Count the SQL, workflow and DAG surface in the language bar. The SQL is
# compiled from the spec and committed as a deliverable: the spec is the
# source, the SQL is the product, and both are tested, so it belongs in
# the bar rather than hidden as build output.
*.sql linguist-detectable=true
*.yml linguist-detectable=true
*.yaml linguist-detectable=true

# Committed measurements are data, not source.
fixtures/** linguist-vendored=false
docs/experiments/*.json linguist-documentation=true

# Normalise line endings so the fixture manifest hashes are stable everywhere.
* text=auto eol=lf
*.parquet binary
*.png binary
*.svg text
